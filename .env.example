# --- Core ---
APP_ENV=dev
BASE_URL=http://127.0.0.1:8000
TIMEZONE=Asia/Shanghai
# Optional: protect /api/* and /api/ws/* with a shared bearer token.
# Leave empty to disable main-site API auth.
API_BEARER_TOKEN=raelyn@2o26$

# --- Database ---
DATABASE_URL=postgresql+psycopg://raelyn:raelyn@127.0.0.1:5432/raelyn
DATABASE_POOL_SIZE=2
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT_SECONDS=30

# --- S3 / MinIO ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=raelyn
S3_USE_SSL=false
ASSET_DIRECT_PROBE_URL=
ASSET_DIRECT_PROBE_TIMEOUT_MS=1000
ASSET_PROXY_BASE_PATH=/api/assets
ASSET_PRESIGN_ENABLED=false

# --- External binaries (optional) ---
# 当前主服务使用 .venv 内安装的 yt-dlp Python 包，不读取 YTDLP_BIN。
# 该变量仅供需要显式调用 yt-dlp CLI 的本地脚本或手动命令复用。
YTDLP_BIN=./bin/yt-dlp
FFMPEG_BIN=./bin/ffmpeg

# --- Audio extraction (ffmpeg) ---
# Lower bitrate helps mobile playback and speeds up ASR uploads.
# Recommended for speech: 64k AAC mono @ 16kHz.
AUDIO_CODEC=aac
AUDIO_BITRATE=64k
AUDIO_SAMPLE_RATE_HZ=16000
AUDIO_CHANNELS=1

# --- yt-dlp network ---
# 高优先级规则：YTDLP_PROXY 只用于 YouTube 的 yt-dlp 同步/下载。
# 非 yt-dlp 的资料/头像抓取、B 站请求、ASR、LLM、Embedding 与健康检查都不走代理。
# 若 shell / systemd 里设置了 HTTP_PROXY / HTTPS_PROXY，确保本机服务不被代理劫持。
NO_PROXY=127.0.0.1,localhost,::1,host.docker.internal
no_proxy=127.0.0.1,localhost,::1,host.docker.internal
# 示例：
#   http://127.0.0.1:7890
#   socks5://127.0.0.1:1080
YTDLP_PROXY=
# Allow yt-dlp to fetch the remote EJS component required by YouTube's JS challenge solver.
# Set empty to disable. Multiple values can be separated by commas or spaces.
YTDLP_REMOTE_COMPONENTS=ejs:github
# 可选的 YouTube PO Token Provider（bgutil HTTP server）。
# 它不同于 EJS/JS challenge 组件，用于帮助 yt-dlp 获取 YouTube 播放请求所需的 PO Token。
# 本机原生运行示例：http://127.0.0.1:4416
# docker-compose 内的 app 使用宿主机地址：http://host.docker.internal:4416
YTDLP_POT_BGUTIL_BASE_URL=
# YouTube yt-dlp 请求的浏览器 impersonation 目标；空值表示不启用。
# 依赖 curl_cffi，默认 chrome 更接近浏览器访问路径。
YTDLP_YOUTUBE_IMPERSONATE=chrome

# --- yt-dlp download quality ---
# yt-dlp format selector (see: https://github.com/yt-dlp/yt-dlp#format-selection)
# Examples:
#   1080p cap (combined MP4/HLS first; avoids YouTube DASH video-only 403 observed on 2026-05-18):
#     best[ext=mp4][height<=1080]/best[height<=1080]/bestvideo[ext=mp4][height<=1080]+bestaudio[ext=m4a]/bestvideo[height<=1080]+bestaudio/best
#   720p cap:
#     best[ext=mp4][height<=720]/best[height<=720]/bestvideo[ext=mp4][height<=720]+bestaudio[ext=m4a]/bestvideo[height<=720]+bestaudio/best
# YTDLP_FORMAT=

# --- Sync / Concurrency ---
SYNC_INTERVAL_MINUTES=60
SYNC_INTERVAL_JITTER_MINUTES=15
SYNC_BATCH_SIZE=2
SYNC_MAX_ENTRIES=10
SYNC_PUBLIC_DISCOVERY_ENABLED=true
SYNC_PUBLIC_DISCOVERY_MAX_ENTRIES=200
SYNC_COOKIE_RECOVERY_MAX_ENTRIES=200
AUTO_DOWNLOAD_NEW_VIDEOS=true
AUTO_GENERATE_BRIEFS=false
STATS_CACHE_TTL_SECONDS=60

YOUTUBE_SYNC_CONCURRENCY=1
BILIBILI_SYNC_CONCURRENCY=1
YOUTUBE_DOWNLOAD_CONCURRENCY=1
BILIBILI_DOWNLOAD_CONCURRENCY=1

# worker 子进程退出后的 supervisor 重启等待秒数。
WORKER_RESTART_DELAY_SECONDS=5
# 进程心跳阈值用于发现 worker 崩溃；执行心跳阈值用于发现心跳线程仍活着但主执行循环卡死。
WORKER_STALE_AFTER_SECONDS=20
WORKER_EXECUTION_STALE_AFTER_SECONDS=120

# --- Optional: ASR (qwen3-asr / OpenAI-compatible) ---
# ASR 健康检查与转写请求忽略进程环境中的 HTTP(S)_PROXY。
# ASR_URL 需要直接指向可达服务地址。
ASR_URL=
# Optional audio language hint. Empty means auto-detect; use en only when the
# audio is known to be English. Leave empty for multilingual/mixed audio.
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=600
# Number of WORKER_ROLE=asr worker processes started by devctl/Docker entrypoint.
# Each asr worker executes one video.asr_transcribe request at a time.
ASR_WORKER_CONCURRENCY=1
# For qwen3-asr-openai, check /health before claiming ASR jobs while backend
# replicas are already saturated.
ASR_BACKEND_CAPACITY_GUARD_ENABLED=true
ASR_BACKEND_CAPACITY_DEFER_SECONDS=30

# --- Optional: Event extraction / Event embeddings ---
EVENT_EXTRACTION_CHUNK_MAX_CHARS=12000
# Ollama /api/generate 专用：事件抽取默认单视频分块、流式读取，并限制上下文与输出长度。
EVENT_EXTRACTION_OLLAMA_STREAM=true
EVENT_EXTRACTION_OLLAMA_NUM_CTX=8192
EVENT_EXTRACTION_OLLAMA_NUM_PREDICT=2500
EVENT_EXTRACTION_OLLAMA_IDLE_TIMEOUT_SECONDS=120
EVENT_EXTRACTION_OLLAMA_BUSY_DEFER_SECONDS=15
EVENT_EXTRACTION_OLLAMA_CHUNK_MAX_CHARS=6000
AUTO_EXTRACT_NEW_VIDEO_EVENTS=true
EMBEDDING_URL=http://10.6.0.10:12302
# 健康检查固定使用 ${EMBEDDING_URL}/health；向量请求才使用 EMBEDDING_ENDPOINT。
EMBEDDING_ENDPOINT=/v1/embeddings
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_SECONDS=120
# 旧整段 transcript embedding / backfill 链路的本地配置；当前事件 Regime 链路不读取这些变量。
# 保留示例用于识别旧 .env 或旧脚本配置，新事件向量化使用 event.embed worker 与上面的 EMBEDDING_* 配置。
EMBEDDING_TRANSCRIPT_VARIANT=plain
EMBEDDING_BATCH_SIZE=8
EMBEDDING_BATCH_MAX_SIZE=16
EMBEDDING_TRANSCRIPT_PREFETCH_WORKERS=4
EMBEDDING_BACKFILL_HTTP_INFLIGHT=2
AUTO_EMBED_NEW_VIDEO_TRANSCRIPTS=false
# Number of WORKER_ROLE=embedding worker processes started by devctl/Docker entrypoint.
# Set to 0 to disable embedding workers on this node.
EMBEDDING_WORKER_CONCURRENCY=1
# Number of WORKER_ROLE=analysis worker processes started by devctl/Docker entrypoint.
# Set to 0 to disable analysis workers on this node.
ANALYSIS_WORKER_CONCURRENCY=1
# Number of WORKER_ROLE=ai worker processes started by devctl/Docker entrypoint.
# Each ai worker executes one LLM-backed job such as video.extract_events at a time.
AI_WORKER_CONCURRENCY=1
ANALYSIS_MIN_AVAILABLE_MEMORY_BYTES=1073741824
ANALYSIS_MAX_RSS_BYTES=6442450944
ANALYSIS_STREAM_BATCH_SIZE=500

# --- Optional: LLM (Transcript polish / Brief / Note) ---
# LLM_URL should be a full endpoint URL.
# Examples:
#   LLM_URL=http://127.0.0.1:11434/api/generate                # Ollama
#   LLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions  # Volcengine Ark (Doubao)
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_HEADERS_JSON=
LLM_TIMEOUT_SECONDS=600

# --- Optional: Volcengine managed inference defaults ---
# These values are only used when runtime config `inference_mode=volcengine`,
# or when you want the hosted-provider preset to have deploy-time defaults.
VOLCENGINE_LLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
VOLCENGINE_LLM_MODEL=
VOLCENGINE_LLM_API_KEY=
VOLCENGINE_LLM_TIMEOUT_SECONDS=600

VOLCENGINE_ASR_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCENGINE_ASR_MODEL=bigmodel
VOLCENGINE_ASR_APP_KEY=
VOLCENGINE_ASR_ACCESS_KEY=
VOLCENGINE_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCENGINE_ASR_TIMEOUT_SECONDS=600

# --- Worker (optional) ---
# If you run multiple workers, you can pin each process to a job subset.
# - WORKER_ROLE: download_youtube | download_bilibili | audio | process | asr | sync | embedding | analysis | ai | all
# - WORKER_TYPES: comma-separated job types (overrides WORKER_ROLE)
# Examples:
#   WORKER_ROLE=process
#   WORKER_TYPES=video.extract_audio,video.asr_transcribe
# WORKER_ROLE=all

# --- MCP HTTP (optional; when API_BEARER_TOKEN is non-empty, API process mounts /mcp) ---
MCP_BASE_PATH=/mcp
# MCP reuses API_BEARER_TOKEN; leave API_BEARER_TOKEN empty to disable both /api auth and MCP mount in local dev.
# Comma-separated public Host values allowed by MCP DNS rebinding protection, e.g. `scisaga.cc:234`.
MCP_ALLOWED_HOSTS=
# Comma-separated public Origin values allowed by MCP DNS rebinding protection, e.g. `https://scisaga.cc:234`.
MCP_ALLOWED_ORIGINS=

# --- GitLab issue automation (optional) ---
# 仅 skills/gitlab-issue/scripts/gitlab_issue.py 读取，用于通过 GitLab API 创建、读取或更新 issue。
# 保持为空表示不启用；不要把真实 Personal Access Token 提交到仓库。
GITLAB_PRIVATE_TOKEN=
