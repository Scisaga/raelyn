# --- Core ---
APP_ENV=dev
BASE_URL=http://127.0.0.1:8000
TIMEZONE=Asia/Shanghai

# --- Database ---
DATABASE_URL=postgresql+psycopg://videosync:videosync@127.0.0.1:5432/videosync

# --- S3 / MinIO ---
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET=video-sync
S3_USE_SSL=false

# --- Binaries (optional) ---
YTDLP_BIN=./bin/yt-dlp
FFMPEG_BIN=./bin/ffmpeg

# --- yt-dlp network ---
# Example:
#   http://127.0.0.1:7890
#   socks5://127.0.0.1:1080
YTDLP_PROXY=

# --- yt-dlp download quality ---
# yt-dlp format selector (see: https://github.com/yt-dlp/yt-dlp#format-selection)
# Examples:
#   1080p cap (mp4+m4a preferred):
#     bestvideo[ext=mp4][height<=1080]+bestaudio[ext=m4a]/best[ext=mp4][height<=1080]/best[height<=1080]/best
#   720p cap:
#     bestvideo[ext=mp4][height<=720]+bestaudio[ext=m4a]/best[ext=mp4][height<=720]/best[height<=720]/best
# YTDLP_FORMAT=

# --- Sync / Concurrency ---
SYNC_INTERVAL_MINUTES=5
SYNC_BATCH_SIZE=20
SYNC_MAX_ENTRIES=10
AUTO_DOWNLOAD_NEW_VIDEOS=true

YOUTUBE_SYNC_CONCURRENCY=1
BILIBILI_SYNC_CONCURRENCY=1
YOUTUBE_DOWNLOAD_CONCURRENCY=2
BILIBILI_DOWNLOAD_CONCURRENCY=2

# --- Optional: ASR (qwen3-asr / OpenAI-compatible) ---
ASR_URL=
ASR_TIMEOUT_SECONDS=600

# --- Optional: LLM (Transcript polish / Brief / Note) ---
# LLM_URL should be a full endpoint URL.
# Examples:
#   LLM_URL=http://127.0.0.1:11434/api/generate                # Ollama
#   LLM_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions  # Volcengine Ark (Doubao)
LLM_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_HEADERS_JSON=
LLM_TIMEOUT_SECONDS=600

# --- Worker (optional) ---
# If you run multiple workers, you can pin each process to a job subset.
# - WORKER_ROLE: download | process | sync | ai | all
# - WORKER_TYPES: comma-separated job types (overrides WORKER_ROLE)
# Examples:
#   WORKER_ROLE=process
#   WORKER_TYPES=video.extract_audio,video.asr_transcribe
# WORKER_ROLE=all
